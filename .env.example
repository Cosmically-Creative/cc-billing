# Copy to .env (mode 600) on the server. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
# 127.0.0.1 is needed by the container health check and the host-side check on port 3040.
DJANGO_ALLOWED_HOSTS=billing.cosmicallycreative.com,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://billing.cosmicallycreative.com

POSTGRES_DB=ccbilling
POSTGRES_USER=ccbilling
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Added at the test install (from the Vault, never committed):
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# EMAIL_HOST=postal.arkhost.com
# EMAIL_PORT=465
# EMAIL_HOST_USER=blake@cosmicallycreative.com
# EMAIL_HOST_PASSWORD=

# Keep delivery disabled before the supervised test install.
CCB_EMAIL_ENABLED=0
EMAIL_BACKEND=django.core.mail.backends.dummy.EmailBackend
# At the test install only: use django.core.mail.backends.smtp.EmailBackend,
# add the SMTP settings from the Vault, and restrict test recipients before enabling.

# Private service access; fill only after verifying OpenBot's private source IP/network.
CCB_PRIVATE_API_ENABLED=0
CCB_SERVICE_NETWORKS=127.0.0.1/32,::1/128
CCB_MCP_ALLOWED_ORIGINS=

# Checkout/webhooks stay off until the supervised sandbox/test-mode install.
CCB_STRIPE_ENABLED=0
CCB_STRIPE_ACCEPT_WEBHOOKS=0
CCB_STRIPE_LIVEMODE=0
CCB_STRIPE_LIVE_ENABLED=0

DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=billing.cosmicallycreative.com,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://billing.cosmicallycreative.com

POSTGRES_DB=ccbilling
POSTGRES_USER=ccbilling
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

